generator client {
  provider = "prisma-client-js"
  // output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int
  image       String?
  category    String

  templateId  String?

  createdAt   DateTime @default(now())

  template    OptionTemplate? @relation(fields: [templateId], references: [id])
}

model OptionTemplate {
  id          String   @id @default(cuid())
  name        String   
  label       String   

  options     Json     

  menuItems   MenuItem[]
}

model Order {
  id        String   @id @default(cuid())
  tableNo   Int
  status    String   @default("pending")
  total     Int
  createdAt DateTime @default(now())
  items     OrderItem[]
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  menuId      String
  quantity    Int
  price       Int
  name        String

  spicyLevel  String?
  sugarLevel  String?
  iceLevel    String?
  notes       String?

  order       Order @relation(fields: [orderId], references: [id])
}