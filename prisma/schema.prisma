generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
}

model MenuItem {
  id          String          @id @default(cuid())
  name        String
  price       Int
  image       String?
  category    String
  createdAt   DateTime        @default(now())
  description String?
  templateId  String?
  costPrice   Int?
  template    OptionTemplate? @relation(fields: [templateId], references: [id])
}

model OptionTemplate {
  id        String     @id @default(cuid())
  name      String     @unique
  label     String
  options   Json
  menuItems MenuItem[]
}

model Order {
  id         String      @id @default(cuid())
  tableNo    Int
  status     String      @default("pending")
  total      Int
  createdAt  DateTime    @default(now())
  customerId String?
  isDeleted  Boolean     @default(false)
  items      OrderItem[]
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  menuId     String
  quantity   Int
  name       String
  price      Int
  iceLevel   String?
  notes      String?
  spicyLevel String?
  sugarLevel String?
  itemStatus String  @default("normal")
  order      Order   @relation(fields: [orderId], references: [id])
}

enum Role {
  ADMIN
  CUSTOMER
}
